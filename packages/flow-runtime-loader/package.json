  },
  "devDependencies": {
    "flow-runtime": "^0.17.0",
    "mocha": "^5.0.0",
    "webpack": "^4.29.0",
    "@babel/plugin-transform-modules-commonjs": "^7.4.0",
    "@babel/cli": "^7.4.0",
    "@babel/preset-env": "^7.4.0",
    "rimraf": "^2.6.3"
  },
  "peerDependencies": {
    "webpack": ">=2"
  }
}