  },
  "devDependencies": {
    "@babel/cli": "^7.12.0",
    "@babel/plugin-proposal-object-rest-spread": "^7.12.1",
    "@babel/polyfill": "^7.12.0",
    "@babel/preset-env": "^7.12.0",
    "@babel/register": "^7.12.0",
    "mocha": "^5.0.0",
    "rimraf": "^2.6.3"
  }
