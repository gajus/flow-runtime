{
  "name": "flow-runtime-loader",
  "version": "0.1.0",
  "description": "webpack loader that turns .js.flow type declarations into flow-runtime types",
  "main": "lib/index.js",
  "license": "MIT",
  "author": "",
  "repository": "https://github.com/gajus/flow-runtime/tree/master/packages/flow-runtime-loader",
